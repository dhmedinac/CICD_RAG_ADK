# Non-secret runtime config for the PROD environment.
# Consumed by the Cloud Build prod trigger as substitutions (see docs/SETUP.md).
# Secrets (API_KEY, DB_PASSWORD) live in Secret Manager, never here.

PROJECT_ID=rag-agent-prod
REGION=us-central1
SERVICE=rag-agent
ENVIRONMENT=prod
AR_REPO=rag-agent
RUNTIME_SA=rag-agent-runtime@rag-agent-prod.iam.gserviceaccount.com
CORPUS_DISPLAY_NAME=rag-agent-corpus
GCS_SOURCE=gs://rag-agent-prod-corpus/
API_KEY_SECRET=rag-agent-api-key
AGENT_MODEL=gemini-2.5-flash

# PostgreSQL Database
# Cloud SQL Connector will use GCP credentials automatically.
# Database URL stored in Secret Manager (rag-agent-database-url) should be:
# postgresql+asyncpg+cloudsql://rag_agent:PASSWORD@${PROJECT_ID}%3A${REGION}%3A${DB_INSTANCE}/rag_agent_sessions
# Note: colons MUST be URL-encoded as %3A
DB_INSTANCE=rag-agent-postgres
DB_NAME=rag_agent_sessions
DB_USER=rag_agent
DB_PASSWORD_SECRET=postgres-password
