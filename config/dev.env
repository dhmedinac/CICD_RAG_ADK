# Non-secret runtime config for the DEV environment.
# Consumed by the Cloud Build dev trigger as substitutions (see docs/SETUP.md).
# Secrets (API_KEY, DB_PASSWORD) live in Secret Manager, never here.

PROJECT_ID=rag-agent-dev-499614
REGION=europe-west1
SERVICE=rag-agent
ENVIRONMENT=dev
AR_REPO=rag-agent
RUNTIME_SA=rag-agent-runtime@rag-agent-dev.iam.gserviceaccount.com
CORPUS_DISPLAY_NAME=rag-agent-corpus
GCS_SOURCE=gs://rag-agent-dev-corpus/
API_KEY_SECRET=rag-agent-api-key
AGENT_MODEL=gemini-2.5-flash

# PostgreSQL Database
DB_INSTANCE=rag-agent-postgres
DB_NAME=rag_agent_sessions
DB_USER=rag_agent
DB_PASSWORD_SECRET=postgres-password
SQL_CONNECTION_NAME=${PROJECT_ID}:${REGION}:${DB_INSTANCE}
