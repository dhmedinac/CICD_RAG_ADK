# Copy to .env for local development:  cp .env.example .env
# Do NOT commit a real .env.

GOOGLE_CLOUD_PROJECT=rag-agent-dev
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE

AGENT_MODEL=gemini-2.5-flash
ENVIRONMENT=dev

# Local API key for the X-API-Key header (leave empty to disable auth locally).
API_KEY=

# Corpus: set RAG_CORPUS to the full resource name to skip the display-name lookup,
# or leave it empty and rely on RAG_CORPUS_DISPLAY_NAME.
RAG_CORPUS=
RAG_CORPUS_DISPLAY_NAME=rag-agent-corpus
SIMILARITY_TOP_K=10
VECTOR_DISTANCE_THRESHOLD=0.5

# PostgreSQL Database (for ADK session persistence)
# Local development: postgresql+asyncpg://user:password@localhost:5432/rag_agent_sessions
# Cloud SQL (Unix socket): postgresql+asyncpg://user:password@/rag_agent_sessions?unix_sock_dir=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=postgresql+asyncpg://rag_agent:password@localhost:5432/rag_agent_sessions

# Cloud SQL connection name (used in Cloud Run): PROJECT:REGION:INSTANCE
CLOUD_SQL_CONNECTION_NAME=
